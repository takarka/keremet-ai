# LLM через OpenRouter (OpenAI-совместимый API). Ключ хранить только здесь, не в коде.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-5.5

# Telegram-бот (P1-16)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Устройство: серийный номер из `adb devices` или IP:порт для Wi-Fi ADB
ANDROID_SERIAL=

# Оценка стоимости в отчётах, $ за 1M токенов (по умолчанию тариф Claude Sonnet; для gpt-4o: 2.5 / 10)
LLM_PRICE_IN_PER_M=3.0
LLM_PRICE_OUT_PER_M=15.0

# Голос (P2-04): OpenAI-совместимый Whisper
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
# STT_LANGUAGE=ru

# Секреты (P2-11): ключ шифрования хранилища. Создать: python -m security.secret_store init
SECRETS_KEY=

# Лимиты одной задачи: стоимость в $ и время в секундах (0 = без лимита)
MAX_COST_USD=0.25
MAX_SECONDS=300
